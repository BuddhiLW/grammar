{:paths ["src"]
 :deps  {org.clojure/clojure {:mvn/version "1.12.7"}
         metosin/malli       {:mvn/version "0.20.3"}}
 :aliases
 {:dev  {:extra-paths ["test" "dev"]
         :extra-deps  {org.clojure/test.check {:mvn/version "1.1.3"}}}
  :test {:extra-paths ["test"]
         :extra-deps  {org.clojure/test.check               {:mvn/version "1.1.3"}
                       io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :jvm-opts    ["-Xmx1g"]
         :main-opts   ["-m" "cognitect.test-runner"]}
  ;; Release tasks from hive-build: clojure -T:build <task>.
  ;; Coordinates in version.edn, version in VERSION.
  :build {:deps       {io.github.hive-agi/hive-build {:mvn/version "0.3.1"}}
          :jvm-opts   ["-Xmx1g"]
          :ns-default hive-build.api}}}
